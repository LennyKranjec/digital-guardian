# Kopie nach .env (nicht committen). Alle Werte sind Demo-Werte, keine Secrets.
APP_NAME=rakathon-platform
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///data/app.db
# DEBUG | INFO | WARNING | ERROR | CRITICAL (anderes: Startfehler)
LOG_LEVEL=INFO

# Ordner des Challenge-Pakets (backend/plugin.py wird geladen, falls vorhanden)
# CHALLENGE_DIR=challenge

# Uhr: APP_FROZEN_NOW friert die Uhr ein (ISO 8601 mit Zeitzone) und ist bei APP_ENV=production ein Startfehler.
# APP_FROZEN_NOW=2026-10-14T08:00:00Z

# Sitzungs-Cookie: hinter HTTPS auf true setzen.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
