{
  "name": "rakathon-platform",
  "private": true,
  "version": "0.1.0",
  "description": "rakathon-platform: neutrales Template (Plattform ohne Fachlogik, nur synthetische Demodaten)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "platform/frontend",
    "platform/packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w platform/frontend",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
